# ============================================================
# Whitelist 方式 — デフォルト全無視、明示的に許可したもののみ管理
# ============================================================

# デフォルト: 全ファイル無視、ディレクトリ traversal のみ許可
*
!*/

# ============================================================
# 許可: ソースコード
# ============================================================
!*.py
!*.rs
!*.ps1

# ============================================================
# 許可: 設定・マニフェスト
# ============================================================
!*.toml
!*.yaml
!*.yml
!*.json
!*.nix
!*.lock
!*.ts
!*.js
!*.html
!*.css

# ============================================================
# 許可: ドキュメント・データ
# ============================================================
!*.csv
!*.xml

# ============================================================
# 許可: GIS 参照データ
# ============================================================
!*.geojson
!*.dbf
!*.prj
!*.shp
!*.shx
!*.zip

# ============================================================
# 許可: ルートの拡張子なしファイル
# ============================================================
!/.gitattributes
!/.gitignore
!/bin/land-value-run

# ============================================================
# 許可: data/geocoding の HTML（format_*.html のみ）
# ============================================================
!data/geocoding/**/*.html

# ============================================================
# 再無視: 上記パターンで拾う不要ファイル・ディレクトリ
# ============================================================

# Python バイトコード
__pycache__/
*.pyc
*.pyo

# 仮想環境
.venv/

# Rust ビルド成果物
/target/
*.so
*.pyd
*.dll
land_value_core/
a.out

# Linter / テストキャッシュ
.ruff_cache/
.hypothesis/
.cache/

# PDF
*.pdf
*.PDF

# バックアップ
*.bak

# Node.js
node_modules/

# Claude 内部 — hooks/skills/settings 以外は再無視
.claude/*
!.claude/hooks/
!.claude/settings.json
!.claude/settings.local.json
!.claude/skills/

# Agent / MCP
.agents/
.codex
.playwright-mcp/

# data/ 配下は参照データ以外は再無視
data/*
!data/geocoding/
!data/landprice/

# 生成物（中身が許可拡張に一致しても管理しない）
input_enriched.csv

# split-address 調査ログ
split-address/research_logs/*.md

# Precheck JSON
config/address_patches/*.precheck.json
